# Server
PORT=8080
APP_ENV=development

# Database (Laragon MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_ktp

# JWT
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_ACCESS_DURATION_MIN=15
JWT_REFRESH_DURATION_DAYS=7

# IoT Device Provisioning
# Kunci rahasia yang harus dikirim device saat pertama kali provision
PROVISION_SECRET=rahasia-provision-iot-2024

#username dan password awal deploy
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API Key Global untuk IoT Device
# Jika diset, semua device bisa pakai kunci ini sebagai X-API-Key
# Device tetap harus kirim X-Node-ID yang valid
# Kosongkan jika ingin tiap device pakai api_key uniknya sendiri (dari provisioning)
DEVICE_API_KEY=iot-ktp-device-key-2024-ganti-ini

# Master Key (bypass semua validasi device, untuk testing/debugging)
# WAJIB dikosongkan di production!
DEVICE_MASTER_KEY=

# Register Mode Timeout (menit), 0 = tidak ada timeout (manual)
REGISTER_MODE_TIMEOUT_MIN=0

# CORS - pisah dengan koma jika banyak origin
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
